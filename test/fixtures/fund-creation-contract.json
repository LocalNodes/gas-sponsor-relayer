{
  "_about": [
    "The fund-creation contract between the gas_sponsor client (Drupal), group_treasury, safe_smart_accounts and gas-sponsor-relayer.",
    "The same file is committed in each repository's tests. Change it in all of them or none.",
    "POST /send/safe-create asks the site's relayer to deploy one group's first Safe and pay the fee. GET /creations/{groupUuid} reads that group's creation slot.",
    "Both routes need the site's bearer token. The relayer builds the factory call itself: the body names owners, threshold and salt, never calldata."
  ],
  "rules": {
    "requestKeys": [
      "actor",
      "chainId",
      "expiresAt",
      "groupUuid",
      "intentUuid",
      "issuedAt",
      "owners",
      "predictedAddress",
      "safeVersion",
      "saltNonce",
      "siteUuid",
      "threshold"
    ],
    "actorKeys": [
      "address",
      "uuid"
    ],
    "extraKeysRefused": true,
    "uuid": "RFC 4122 text form, lower case: ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "owners": "1 to 10 distinct, non-zero addresses; order is kept and is part of the address",
    "threshold": "integer, 1 to count(owners)",
    "saltNonce": "decimal string, no leading zeros, below 2^256",
    "envelope": "expiresAt - issuedAt is 1 to 300 seconds; a new acceptance needs issuedAt <= now + 60 and now <= expiresAt; an exact repeat of an accepted intent is answered after expiry",
    "chains": "only chains whose networks.json entry is sponsored and has fundCreation true (Ethereum Sepolia at first); version 1.4.1 only",
    "intentDigest": "relayer-internal: the slot is the same intent when chainId, intentUuid, owners (checksummed, in order), predictedAddress, safeVersion, saltNonce and threshold are all equal. The actor and the envelope are not part of it.",
    "slot": "one per (siteUuid, groupUuid), for ever. An exact repeat of the slot's intent gets the slot's answer; any other intent gets 409 slot_taken. Only a not_sent slot sends again, and only for the same intent.",
    "quota": "new funded attempts: 1 per actor and 3 per site in a rolling 24 hours (operator-set). An attempt counts from the claim and is given back only when nothing was broadcast.",
    "statuses": {
      "sending": "claimed; the send is being prepared or broadcast, no hash known yet",
      "pending": "broadcast; waiting for the receipt",
      "confirmed": "mined and succeeded",
      "failed": "mined and reverted; the attempt and the fee are spent; never sent again",
      "not_sent": "refused or failed before broadcast; the same intent may be sent again"
    },
    "codes": {
      "creation_not_found": "GET /creations/{groupUuid} 404 when the slot is empty; any other 404 (an unknown route) is not an answer about the group",
      "payer_empty": "502 broadcast:false when the fee account cannot pay; nothing was sent and the same intent may be sent again",
      "send_failed": "502 broadcast:false, the error for every failure before broadcast; reason payer_empty (the fee account cannot pay), fee_estimate_failed (the fee could not be read) or \"send failed\" (the node refused the transaction). Nothing was sent and the same intent may be sent again. A 502 without broadcast:false is not this answer (a gateway may have answered after a send)."
    }
  },
